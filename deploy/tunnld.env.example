# Copy to /etc/tunnl/tunnld.env and replace every placeholder.
# Flags override environment variables. Environment variables override a JSON --config file.

TUNNL_BASE_DOMAIN=example.com
TUNNL_HTTP_ADDR=:8080
TUNNL_HTTPS_ADDR=:8443
TUNNL_QUIC_ADDR=:8443
TUNNL_PUBLIC_PORT=443
TUNNL_DATABASE=/var/lib/tunnl/tunnl.db
TUNNL_ACME_STORAGE=/var/lib/tunnl/acme

# Leave bootstrap tokens empty after the admin panel has issued client tokens.
TUNNL_AUTH_TOKENS=

TUNNL_ACME=true
TUNNL_ACME_EMAIL=you@example.com
TUNNL_ACME_STAGING=false
# Cloudflare API token with Zone.Zone:Read and Zone.DNS:Edit on this zone.
TUNNL_CLOUDFLARE_API_TOKEN=replace-me

TUNNL_ADMIN_ADDR=127.0.0.1:9090
TUNNL_ADMIN_TOKEN=replace-with-tunnld-generate-admin-token
TUNNL_METRICS_ADDR=127.0.0.1:9091
TUNNL_LOG_LEVEL=info

TUNNL_MAX_REQUEST_BODY=33554432
TUNNL_MAX_RESPONSE_BODY=33554432
TUNNL_REQUEST_TIMEOUT=2m
TUNNL_ACCEPT_LIMIT=30
TUNNL_HANDSHAKE_FAILURE_LIMIT=20
TUNNL_HEARTBEAT_TIMEOUT=40s
